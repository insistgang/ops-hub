<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>__PORT__</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>Label</key>
    <string>com.insistgang.opshub.vitaflow-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__BRIDGE_SCRIPT__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/vitaflow-bridge.err.log</string>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/vitaflow-bridge.out.log</string>
</dict>
</plist>
