#!/usr/bin/env python3
"""
ops: Personal Operations Hub CLI & Automation Suite
Usage:
  ops status                    View overall system status
  ops dispatch [query]          View device task allocation matrix or route a specific task
  ops sync [--push]             Probe live network, update status.json (and push to GitHub)
  ops career list               List all job applications
  ops career update <comp> ...  Update company application status
  ops check <item>              Check off daily discipline items (起了/动了/写了/关了)
  ops memory                    Print order principles and scene contracts
  ops serve [--port 3000]       Preview the Web Dashboard locally
  ops schedule <cmd>            Manage macOS launchd auto-sync service
"""

import sys
import os
import json
import shutil
import argparse
import subprocess
import webbrowser
from pathlib import Path
from datetime import datetime

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"

sys.path.insert(0, str(BASE_DIR / "scripts"))
import collector

class Colors:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    DIM = '\033[2m'

def cmd_status(args):
    status_file = DATA_DIR / "status.json"
    if not status_file.exists():
        print("⚡ 首次运行，正在采集全局真实状态...")
        collector.collect_all()

