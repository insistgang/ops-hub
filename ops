def cmd_schedule(args):
    action = args.sched_action
    dest = Path.home() / "Library" / "LaunchAgents" / "com.insistgang.opshub.plist"

    if action == "install":
        print("⚙️  正在注册 macOS 原生 launchd 早晚定时同步服务...")
        # TCC 完全磁盘访问权限是"按二进制"授权的：优先使用已被用户授权的解释器
        # （如本机已授权的 uv python3.11），而非默认的 CLT /usr/bin/python3。
        # 可用环境变量 OPS_PYTHON 显式覆盖。realpath 解析符号链接以匹配 TCC 记录。
        python_bin = os.path.realpath(os.environ.get("OPS_PYTHON") or shutil.which("python3.11") or "/usr/bin/python3")
        print(f"🐍 定时任务解释器: {python_bin}")
        tcc_dirs = [Path.home() / d for d in ("Desktop", "Documents", "Downloads")]
        if any(str(BASE_DIR).startswith(str(d)) for d in tcc_dirs):
            print(f"{Colors.WARNING}⚠️  项目位于 macOS 隐私保护目录 ({BASE_DIR})。")
            print(f"   若定时任务日志出现 'Operation not permitted'，请给上述解释器授权:")
            print(f"   系统设置 → 隐私与安全性 → 完全磁盘访问权限 → 添加 {python_bin}")
            print(f"   授权后执行 ops schedule status 可看到真实退出码。{Colors.ENDC}")
        dest.parent.mkdir(parents=True, exist_ok=True)
        plist_content = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.insistgang.opshub</string>
    <key>ProgramArguments</key>
    <array>
        <string>{python_bin}</string>
        <string>{BASE_DIR}/scripts/collector.py</string>
        <string>--push</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/opshub_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/opshub_sync_err.log</string>
</dict>
</plist>
"""
        with open(dest, "w", encoding="utf-8") as f:
            f.write(plist_content)
        subprocess.run(["launchctl", "unload", str(dest)], stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl", "load", str(dest)], check=True)
        print(f"✅ 已成功安装 launchd 服务: {dest}")
        print("🕒 自动执行时间: 每天 09:00 与 21:00 (休眠唤醒后自动对齐)")
    elif action == "status":
        res = subprocess.run(["launchctl", "list"], stdout=subprocess.PIPE, text=True)
        line = next((l for l in res.stdout.splitlines() if "com.insistgang.opshub" in l), None)
        if not line:
            print("⚪ launchd 定时服务当前状态: [未安装/未加载]")
            return
        # launchctl list columns: PID \t LastExitStatus \t Label
        parts = line.split("\t")
        pid = parts[0] if len(parts) > 0 else "-"
        last_exit = parts[1] if len(parts) > 1 else "?"
        if pid != "-":
            print(f"🟢 launchd 定时服务当前状态: [正在执行中] (PID {pid})")
        elif last_exit == "0":
            print(f"🟢 launchd 定时服务当前状态: [已加载，等待调度] (上次执行成功)")
        else:
            print(f"🔴 launchd 定时服务已加载，但上次执行失败 (退出码 {last_exit})！")
            err_log = Path("/tmp/opshub_sync_err.log")
            err_text = ""
            if err_log.exists():
                err_text = err_log.read_text(encoding="utf-8", errors="replace")
                tail = [l for l in err_text.strip().splitlines() if l.strip()][-3:]
                if tail:
                    print(f"{Colors.DIM}   最近错误日志:{Colors.ENDC}")
                    for l in tail:
                        print(f"   {Colors.FAIL}{l}{Colors.ENDC}")
            if "Operation not permitted" in err_text:
                interp = "/usr/bin/python3"
                try:
                    import plistlib
                    with open(dest, "rb") as f:
                        interp = plistlib.load(f).get("ProgramArguments", [interp])[0]
                except Exception:
                    pass
                print(f"   {Colors.WARNING}💡 这是 macOS 隐私权限 (TCC) 拦截。修复: 系统设置 → 隐私与安全性 →")
                print(f"      完全磁盘访问权限 → 添加 {interp}，然后 ops schedule install 重载服务。{Colors.ENDC}")
            sys.exit(1)
    elif action == "uninstall":
        if dest.exists():
            subprocess.run(["launchctl", "unload", str(dest)], stderr=subprocess.DEVNULL)
            dest.unlink()
            print("✅ 已成功卸载 launchd 服务。")
        else:
            print("ℹ️ 未发现已安装的 launchd 服务文件。")

def main():
    parser = argparse.ArgumentParser(description="Ops-Hub: Personal Operations Console CLI")
    subparsers = parser.add_subparsers(dest="command")

    p_status = subparsers.add_parser("status", help="打印总台全局状态摘要")

    # ops dispatch [query]
    p_disp = subparsers.add_parser("dispatch", help="查看三端设备任务分工矩阵或查询分流指引")
    p_disp.add_argument("query", nargs="?", help="任务关键词 (如: 论文, 训练, yolo, 构建, 求职, 日记)")

    p_sync = subparsers.add_parser("sync", help="全量探测并刷新状态")
    p_sync.add_argument("--push", action="store_true", help="探测后自动推送至 GitHub")

    p_career = subparsers.add_parser("career", help="管理求职投递记录")
    p_career.add_argument("career_action", choices=["list", "update", "add"], help="操作")
    p_career.add_argument("company", nargs="?", help="公司名称")
    p_career.add_argument("--status", help="新状态 (已投递/简历初筛/笔试中/一面/二面/Offer)")
    p_career.add_argument("--pos", help="岗位名称")
    p_career.add_argument("--date", help="投递日期")
    p_career.add_argument("--priority", choices=["High", "Medium", "Low"], help="优先级")
    p_career.add_argument("--notes", help="跟进备注")
    p_career.add_argument("--push", action="store_true", help="修改后自动推送")

    p_check = subparsers.add_parser("check", help="今日四勾秩序打卡 (起了/动了/写了/关了)")
    p_check.add_argument("item", choices=["起了", "动了", "写了", "关了"], help="打卡项")
    p_check.add_argument("--toggle", action="store_true", help="反转状态")
    p_check.add_argument("--push", action="store_true", help="打卡后自动推送")

    p_memory = subparsers.add_parser("memory", help="查看个人记忆与秩序原则")

    p_serve = subparsers.add_parser("serve", help="本地静态 Web 预览服务")
    p_serve.add_argument("--port", type=int, default=3000, help="预览端口 (默认 3000)")

    p_schedule = subparsers.add_parser("schedule", help="管理 macOS 原生 launchd 定时同步")
    p_schedule.add_argument("sched_action", choices=["install", "status", "uninstall"], help="操作")

    args = parser.parse_args()

    if not args.command or args.command == "status":
        cmd_status(args)
    elif args.command == "dispatch":
        cmd_dispatch(args)
    elif args.command == "sync":
        cmd_sync(args)
    elif args.command == "career":
        cmd_career(args)
    elif args.command == "check":
        cmd_check(args)
    elif args.command == "memory":
        cmd_memory(args)
    elif args.command == "serve":
        cmd_serve(args)
    elif args.command == "schedule":
        cmd_schedule(args)

if __name__ == "__main__":
    main()
