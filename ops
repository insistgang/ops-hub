#!/usr/bin/env python3
"""
ops: Personal Operations Hub CLI & Automation Suite
Usage:
  ops status                    View overall system status
  ops sync [--push]             Probe live network, update status.json (and push to GitHub)
  ops career list               List all job applications
  ops career update <comp> ...  Update company application status
  ops check <item>              Check off daily discipline items (起了/动了/写了/关了)
  ops memory                    Print order principles and scene contracts
  ops serve [--port 3000]       Preview the Web Dashboard locally
  ops schedule <cmd>            Manage macOS launchd auto-sync service
"""

import sys
import os
import json
import argparse
import subprocess
import webbrowser
from pathlib import Path
from datetime import datetime

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"

# Add scripts directory to sys.path
sys.path.insert(0, str(BASE_DIR / "scripts"))
import collector

class Colors:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    DIM = '\033[2m'

def cmd_status(args):
    status_file = DATA_DIR / "status.json"
    if not status_file.exists():
        print("⚡ 首次运行，正在采集全局真实状态...")
        collector.collect_all()

    with open(status_file, "r", encoding="utf-8") as f:
        data = json.load(f)

    meta = data.get("meta", {})
    topo = data.get("topology", {})
    mac = topo.get("mac", {})
    win = topo.get("windows", {})
    career = data.get("career_summary", {})
    c_stats = career.get("stats", {})
    c_records = career.get("records", [])
    projects = data.get("projects_and_exams", [])
    weight = data.get("weight_challenge", {})
    checks = data.get("daily_checks", {}).get("checks", {})

    print(f"\n{Colors.BOLD}{Colors.CYAN}══════════════════════════════════════════════════════════════════{Colors.ENDC}")
    print(f"{Colors.BOLD}{Colors.HEADER} 🚀 OPS-HUB // 个人数字化运营工作总台{Colors.ENDC}  {Colors.DIM}(v{meta.get('version', '1.0')}){Colors.ENDC}")
    print(f"{Colors.DIM} 最后同步: {meta.get('last_synced', '-')} ｜ 探针: {meta.get('sync_mode', 'Live')}{Colors.ENDC}")
    print(f"{Colors.BOLD}{Colors.CYAN}══════════════════════════════════════════════════════════════════{Colors.ENDC}\n")

    # 1. Dual-Machine
    win_status_color = Colors.GREEN if win.get("status") == "Online" else Colors.FAIL
    lat = win.get("latency_ms")
    lat_str = f"{lat} ms" if lat else "N/A"
    print(f"{Colors.BOLD}🖥️  双机拓扑与算力状态:{Colors.ENDC}")
    print(f"   💻 Mac 本地:  {Colors.GREEN}● 在线{Colors.ENDC}  [{mac.get('device', 'MacBook Air')}]  电量: {mac.get('battery')} ({mac.get('power_state')})")
    print(f"   🖥️  Win 4070S: {win_status_color}● {win.get('status')}{Colors.ENDC} [{win.get('ip')}]  延迟: {Colors.CYAN}{lat_str}{Colors.ENDC}  Ollama: {win.get('services', [''])[0]}")

    # 2. Career Pipeline
    print(f"\n{Colors.BOLD}🎯 求职投递大盘 (Career Pipeline):{Colors.ENDC}")
    print(f"   总计: {c_stats.get('total')} 家 ｜ 面试中: {Colors.GREEN}{c_stats.get('interviewing')}{Colors.ENDC} ｜ 笔试中: {Colors.WARNING}{c_stats.get('tests')}{Colors.ENDC} ｜ 简历初筛: {Colors.CYAN}{c_stats.get('screening')}{Colors.ENDC} ｜ 已投递: {c_stats.get('applied')}")
    for c in c_records[:4]:
        st = c.get('status')
        st_color = Colors.GREEN if "面" in st else (Colors.CYAN if "初筛" in st else Colors.DIM)
        print(f"   • {Colors.BOLD}{c.get('company')}{Colors.ENDC} - {c.get('position')} [{st_color}{st}{Colors.ENDC}]")
    if len(c_records) > 4:
        print(f"     {Colors.DIM}...还有 {len(c_records) - 4} 家企业 (敲 ops career list 查看全部){Colors.ENDC}")

    # 3. Exams & Projects
    print(f"\n{Colors.BOLD}⏳ 考期冲刺与项目推进:{Colors.ENDC}")
    for p in projects:
        if p.get("type") == "exam":
            days = p.get("days_left", 0)
            urgency = Colors.FAIL if days <= 20 else Colors.WARNING
            print(f"   🔴 {Colors.BOLD}{p.get('name')}{Colors.ENDC} ➔ 剩余 {urgency}{days} 天{Colors.ENDC} (考期: {p.get('target_date')})")
        else:
            h = p.get('commit_hash', '-')
            t = p.get('commit_time', '-')
            print(f"   📦 {Colors.BOLD}{p.get('name')}{Colors.ENDC} ➔ {Colors.DIM}[{h} @ {t}]{Colors.ENDC} {p.get('next_action', '')}")

    # 4. Weight Challenge
    print(f"\n{Colors.BOLD}⚖️  秋季三人减重决战 (38天):{Colors.ENDC}")
    print(f"   进度: 第 {Colors.CYAN}{weight.get('current_day')}{Colors.ENDC}/{weight.get('total_days')} 天 ｜ 剩余: {weight.get('days_left')} 天 ｜ 成员: {', '.join(weight.get('members', []))}")
    print(f"   公网直通: {Colors.BLUE}{weight.get('live_url')}{Colors.ENDC}")

    # 5. Today's Four Checks
    c_sun = "✅" if checks.get("起了") else "⬜"
    c_act = "✅" if checks.get("动了") else "⬜"
    c_write = "✅" if checks.get("写了") else "⬜"
    c_sleep = "✅" if checks.get("关了") else "⬜"
    print(f"\n{Colors.BOLD}🧠 今日四勾秩序基线:{Colors.ENDC}")
    print(f"   [{c_sun} 起了]   [{c_act} 动了]   [{c_write} 写了]   [{c_sleep} 关了]")
    print(f"{Colors.DIM}   (快速打卡: ops check 动了 / ops check 写了)\n{Colors.ENDC}")

def cmd_sync(args):
    print("🔄 正在执行全量探测与状态刷新...")
    res = collector.collect_all()
    print(f"✅ 状态快照已更新至 data/status.json")
    if args.push:
        collector.gitops_push()

def cmd_career(args):
    career_file = DATA_DIR / "career_records.json"
    records = []
    if career_file.exists():
        with open(career_file, "r", encoding="utf-8") as f:
            records = json.load(f)

    if args.career_action == "list":
        print(f"\n{Colors.BOLD}📋 Career Pipeline 全量投递清单 ({len(records)} 家):{Colors.ENDC}\n")
        for i, c in enumerate(records, 1):
            st = c.get('status')
            st_color = Colors.GREEN if "面" in st else (Colors.CYAN if "初筛" in st else Colors.DIM)
            print(f"[{i:02d}] {Colors.BOLD}{c.get('company')}{Colors.ENDC} ｜ {c.get('position')}")
            print(f"     状态: [{st_color}{st}{Colors.ENDC}] ｜ 投递日: {c.get('apply_date')} ｜ 优先级: {c.get('priority')}")
            if c.get("notes"):
                print(f"     备注: {Colors.DIM}{c.get('notes')}{Colors.ENDC}")
            print()
    elif args.career_action == "update":
        target = args.company
        found = False
        for c in records:
            if target.lower() in c.get("company", "").lower():
                found = True
                old_status = c.get("status")
                c["status"] = args.status
                if args.notes:
                    c["notes"] = args.notes
                print(f"✅ 已更新 [{c.get('company')}]: {old_status} ➔ {Colors.GREEN}{args.status}{Colors.ENDC}")
                break
        if not found:
            print(f"❌ 未找到公司包含 '{target}' 的记录，如需新增请使用 ops career add")
        else:
            with open(career_file, "w", encoding="utf-8") as f:
                json.dump(records, f, ensure_ascii=False, indent=2)
            collector.collect_all()
            if args.push:
                collector.gitops_push()
    elif args.career_action == "add":
        new_id = f"c-{len(records)+1:03d}"
        new_item = {
            "id": new_id,
            "company": args.company,
            "position": args.pos or "研发工程师",
            "apply_date": args.date or datetime.now().strftime("%Y-%m-%d"),
            "status": args.status or "已投递",
            "priority": args.priority or "Medium",
            "notes": args.notes or ""
        }
        records.append(new_item)
        with open(career_file, "w", encoding="utf-8") as f:
            json.dump(records, f, ensure_ascii=False, indent=2)
        print(f"✅ 已新增企业投递记录: [{args.company}] - {new_item['position']}")
        collector.collect_all()
        if args.push:
            collector.gitops_push()

def cmd_check(args):
    checks_file = DATA_DIR / "daily_checks.json"
    data = {
        "date": datetime.now().strftime("%Y-%m-%d"),
        "checks": { "起了": False, "动了": False, "写了": False, "关了": False }
    }
    if checks_file.exists():
        with open(checks_file, "r", encoding="utf-8") as f:
            data = json.load(f)

    target_key = args.item
    valid_keys = ["起了", "动了", "写了", "关了"]
    if target_key not in valid_keys:
        print(f"❌ 打卡项必须是以下之一: {', '.join(valid_keys)}")
        return

    # Toggle or set True
    curr = data.get("checks", {}).get(target_key, False)
    new_val = not curr if args.toggle else True
    data["checks"][target_key] = new_val

    with open(checks_file, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

    status_icon = "✅" if new_val else "⬜"
    print(f"🎯 今日秩序打卡: [{target_key}] ➔ {status_icon} ({'已完成' if new_val else '未完成'})")
    collector.collect_all()
    if args.push:
        collector.gitops_push()

def cmd_memory(args):
    rules_file = DATA_DIR / "memory_rules.json"
    if not rules_file.exists():
        print("未找到 memory_rules.json")
        return
    with open(rules_file, "r", encoding="utf-8") as f:
        rules = json.load(f)

    print(f"\n{Colors.BOLD}{Colors.HEADER}🧠 {rules.get('title')}{Colors.ENDC}")
    print(f"{Colors.DIM}座右铭: {rules.get('motto')}{Colors.ENDC}\n")

    print(f"{Colors.BOLD}1. 场景分工契约 (一个地方，一种模式):{Colors.ENDC}")
    for sc in rules.get("scene_contracts", []):
        print(f"   {Colors.BOLD}{sc.get('scene')}{Colors.ENDC} ➔ {Colors.CYAN}{sc.get('mode')}{Colors.ENDC}")
        for r in sc.get("rules", []):
            print(f"     • {r}")
    
    print(f"\n{Colors.BOLD}2. 聚焦防散铁律:{Colors.ENDC}")
    for fp in rules.get("focus_principles", []):
        print(f"   • {Colors.BOLD}{fp.get('principle')}{Colors.ENDC}: {fp.get('desc')}")

    print(f"\n{Colors.BOLD}3. 养生补剂契约:{Colors.ENDC}")
    hs = rules.get("health_supplements", {})
    print(f"   {Colors.WARNING}※ {hs.get('rule')}{Colors.ENDC}")
    for sch in hs.get("schedule", []):
        print(f"     - {sch.get('period')}: {sch.get('items')}")
    print()

def cmd_serve(args):
    port = args.port or 3000
    print(f"🌐 正在启动 Ops-Hub Web 总台本地预览...")
    print(f"👉 访问地址: http://localhost:{port}")
    webbrowser.open(f"http://localhost:{port}")
    try:
        subprocess.run(["python3", "-m", "http.server", str(port)], cwd=str(BASE_DIR))
    except KeyboardInterrupt:
        print("\n👋 Web 预览服务已停止。")

def cmd_schedule(args):
    action = args.sched_action
    plist_src = BASE_DIR / "scripts" / "com.insistgang.opshub.plist"
    dest = Path.home() / "Library" / "LaunchAgents" / "com.insistgang.opshub.plist"

    if action == "install":
        print("⚙️  正在注册 macOS 原生 launchd 早晚定时同步服务...")
        dest.parent.mkdir(parents=True, exist_ok=True)
        # Generate plist with exact python and script path
        plist_content = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.insistgang.opshub</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>{BASE_DIR}/scripts/collector.py</string>
        <string>--push</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/opshub_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/opshub_sync_err.log</string>
</dict>
</plist>
"""
        with open(dest, "w", encoding="utf-8") as f:
            f.write(plist_content)
        subprocess.run(["launchctl", "unload", str(dest)], stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl", "load", str(dest)], check=True)
        print(f"✅ 已成功安装 launchd 服务: {dest}")
        print("🕒 自动执行时间: 每天 09:00 与 21:00 (休眠唤醒后自动对齐)")
    elif action == "status":
        res = subprocess.run(["launchctl", "list"], stdout=subprocess.PIPE, text=True)
        if "com.insistgang.opshub" in res.stdout:
            print("🟢 launchd 定时服务当前状态: [已加载并运行中]")
        else:
            print("⚪ launchd 定时服务当前状态: [未安装/未加载]")
    elif action == "uninstall":
        if dest.exists():
            subprocess.run(["launchctl", "unload", str(dest)], stderr=subprocess.DEVNULL)
            dest.unlink()
            print("✅ 已成功卸载 launchd 服务。")
        else:
            print("ℹ️ 未发现已安装的 launchd 服务文件。")

def main():
    parser = argparse.ArgumentParser(description="Ops-Hub: Personal Operations Console CLI")
    subparsers = parser.add_subparsers(dest="command")

    # ops status
    p_status = subparsers.add_parser("status", help="打印总台全局状态摘要")

    # ops sync
    p_sync = subparsers.add_parser("sync", help="全量探测并刷新状态")
    p_sync.add_argument("--push", action="store_true", help="探测后自动推送至 GitHub")

    # ops career
    p_career = subparsers.add_parser("career", help="管理求职投递记录")
    p_career.add_argument("career_action", choices=["list", "update", "add"], help="操作")
    p_career.add_argument("company", nargs="?", help="公司名称")
    p_career.add_argument("--status", help="新状态 (已投递/简历初筛/笔试中/一面/二面/Offer)")
    p_career.add_argument("--pos", help="岗位名称")
    p_career.add_argument("--date", help="投递日期")
    p_career.add_argument("--priority", choices=["High", "Medium", "Low"], help="优先级")
    p_career.add_argument("--notes", help="跟进备注")
    p_career.add_argument("--push", action="store_true", help="修改后自动推送")

    # ops check
    p_check = subparsers.add_parser("check", help="今日四勾秩序打卡 (起了/动了/写了/关了)")
    p_check.add_argument("item", choices=["起了", "动了", "写了", "关了"], help="打卡项")
    p_check.add_argument("--toggle", action="store_true", help="反转状态")
    p_check.add_argument("--push", action="store_true", help="打卡后自动推送")

    # ops memory
    p_memory = subparsers.add_parser("memory", help="查看个人记忆与秩序原则")

    # ops serve
    p_serve = subparsers.add_parser("serve", help="本地静态 Web 预览服务")
    p_serve.add_argument("--port", type=int, default=3000, help="预览端口 (默认 3000)")

    # ops schedule
    p_sched = subparsers.add_parser("schedule", help="管理 macOS 原生 launchd 定时同步")
    p_sched.add_argument("sched_action", choices=["install", "status", "uninstall"], help="操作")

    args = parser.parse_args()

    if not args.command or args.command == "status":
        cmd_status(args)
    elif args.command == "sync":
        cmd_sync(args)
    elif args.command == "career":
        cmd_career(args)
    elif args.command == "check":
        cmd_check(args)
    elif args.command == "memory":
        cmd_memory(args)
    elif args.command == "serve":
        cmd_serve(args)
    elif args.command == "schedule":
        cmd_schedule(args)

if __name__ == "__main__":
    main()
