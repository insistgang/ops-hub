def cmd_career(args):
    career_file = DATA_DIR / "career_records.json"
    records = []
    if career_file.exists():
        with open(career_file, "r", encoding="utf-8") as f:
            records = json.load(f)

    if args.career_action == "list":
        print(f"\n{Colors.BOLD}📋 Career Pipeline 全量投递清单 ({len(records)} 家):{Colors.ENDC}\n")
        for i, c in enumerate(records, 1):
            st = c.get('status')
            st_color = Colors.GREEN if "面" in st else (Colors.CYAN if "初筛" in st else Colors.DIM)
            print(f"[{i:02d}] {Colors.BOLD}{c.get('company')}{Colors.ENDC} ｜ {c.get('position')}")
            print(f"     状态: [{st_color}{st}{Colors.ENDC}] ｜ 投递日: {c.get('apply_date')} ｜ 优先级: {c.get('priority')}")
            if c.get("notes"):
                print(f"     备注: {Colors.DIM}{c.get('notes')}{Colors.ENDC}")
            print()
    elif args.career_action == "update":
        if not args.company:
            print(f"{Colors.FAIL}❌ 用法: ops career update <公司名> --status <新状态> [--notes 备注] [--push]{Colors.ENDC}")
            sys.exit(2)
        if not args.status:
            print(f"{Colors.FAIL}❌ 缺少 --status 参数 (如: --status 一面 / 笔试中 / Offer){Colors.ENDC}")
            sys.exit(2)
        target = args.company
        found = False
        for c in records:
            if target.lower() in c.get("company", "").lower():
                found = True
                old_status = c.get("status")
                c["status"] = args.status
                if args.notes:
                    c["notes"] = args.notes
                print(f"✅ 已更新 [{c.get('company')}]: {old_status} ➔ {Colors.GREEN}{args.status}{Colors.ENDC}")
                break
        if not found:
            print(f"❌ 未找到公司包含 '{target}' 的记录，如需新增请使用 ops career add")
        else:
            collector.atomic_write_text(career_file, json.dumps(records, ensure_ascii=False, indent=2) + "\n")
            if not collector.run_pipeline(push=args.push):
                sys.exit(1)
    elif args.career_action == "add":
        if not args.company:
            print(f"{Colors.FAIL}❌ 用法: ops career add <公司名> [--pos 岗位] [--status 状态] [--date 日期] [--notes 备注]{Colors.ENDC}")
            sys.exit(2)
        new_id = f"c-{len(records)+1:03d}"
        new_item = {
            "id": new_id,
            "company": args.company,
            "position": args.pos or "研发工程师",
            "apply_date": args.date or datetime.now().strftime("%Y-%m-%d"),
            "status": args.status or "已投递",
            "priority": args.priority or "Medium",
            "notes": args.notes or ""
        }
        records.append(new_item)
        collector.atomic_write_text(career_file, json.dumps(records, ensure_ascii=False, indent=2) + "\n")
        print(f"✅ 已新增企业投递记录: [{args.company}] - {new_item['position']}")
        if not collector.run_pipeline(push=args.push):
            sys.exit(1)

def cmd_check(args):
    checks_file = DATA_DIR / "daily_checks.json"
    data = collector.load_json(checks_file, {
        "date": datetime.now().strftime("%Y-%m-%d"),
        "checks": { "起了": False, "动了": False, "写了": False, "关了": False },
        "history": []
    })

    # Cross-day rollover: archive yesterday's record before toggling today's
    data, rolled = collector.rollover_daily_checks(data)
    if rolled and data.get("history"):
        print(f"🗓️  已跨天：自动归档 {data['history'][-1]['date']} 的打卡记录，开启今日新基线。")

    target_key = args.item
    valid_keys = ["起了", "动了", "写了", "关了"]
    if target_key not in valid_keys:
        print(f"❌ 打卡项必须是以下之一: {', '.join(valid_keys)}")
        return

    curr = data.get("checks", {}).get(target_key, False)
    new_val = not curr if args.toggle else True
    data["checks"][target_key] = new_val

    collector.atomic_write_text(checks_file, json.dumps(data, ensure_ascii=False, indent=2) + "\n")

    status_icon = "✅" if new_val else "⬜"
    print(f"🎯 今日秩序打卡: [{target_key}] ➔ {status_icon} ({'已完成' if new_val else '未完成'})")
    if not collector.run_pipeline(push=args.push):
        sys.exit(1)

