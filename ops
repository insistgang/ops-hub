#!/usr/bin/env python3
"""
ops: Ops-Hub 个人数字化运营工作总台 CLI 入口（纯 Python 3 标准库）

用法概览:
  ops status                    打印三端算力、求职、项目、知识库与今日四勾全局摘要
  ops dispatch [query]          查看三端设备任务分工矩阵，或按关键词智能路由任务
  ops sync [--push] [--all]     探针采集刷新快照（--push 推 GitHub；--all 全链路含阿里云与账本）
  ops career <list|add|update>  查看求职投递投影（上游缺失时作为本地回退维护）
  ops check <起了|动了|写了|关了>  快速打卡今日四勾（跨天自动归档重置）
  ops weight [数值]              查看或记录个人体重档案
  ops memory                    查看个人场景契约与聚焦防散基线
  ops publish                   发布公开产物到阿里云 ops-hub 站点
  ops finance                   同步日记个人实付消费至财务账本并发布
  ops sync-service <status|deploy>  核对/部署阿里云 VitaFlow 同步服务
  ops quota                     查看 AI 额度快照与早停判定
  ops serve [--port 3000]       启动仅监听 127.0.0.1 的本地 Web 预览
  ops schedule <install|status|uninstall>  管理 macOS launchd 定时同步服务
"""

import argparse
import sys
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(BASE_DIR / "scripts"))

import cli_commands
from ops_common import DAILY_CHECK_KEYS


def build_parser():
    parser = argparse.ArgumentParser(description="Ops-Hub: Personal Operations Console CLI")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="打印总台全局状态摘要")

    p_disp = sub.add_parser("dispatch", help="查看三端设备分工矩阵或查询分流指引")
    p_disp.add_argument("query", nargs="?", help="任务关键词 (如: 论文, 训练, yolo, 构建, 求职, 机器人)")

    p_sync = sub.add_parser("sync", help="全量探测并刷新状态快照")
    p_sync.add_argument("--push", action="store_true", help="采集后提交并推送到 GitHub")
    p_sync.add_argument("--all", action="store_true", help="执行完整四步流水线（采集+GitHub+阿里云+账本）")

    p_career = sub.add_parser("career", help="查看或回退维护求职投递记录")
    p_career.add_argument("career_action", choices=["list", "update", "add"], help="操作类型")
    p_career.add_argument("company", nargs="?", help="公司名称")
    p_career.add_argument("--status", help="新状态 (已投递/初筛/笔试中/面试中/已录用)")
    p_career.add_argument("--pos", help="岗位名称")
    p_career.add_argument("--date", help="投递或更新日期")
    p_career.add_argument("--priority", choices=["High", "Medium", "Low"], help="优先级")
    p_career.add_argument("--notes", help="跟进备注")
    p_career.add_argument("--push", action="store_true", help="修改后自动推送")

    p_check = sub.add_parser("check", help="今日四勾秩序打卡")
    p_check.add_argument("item", choices=list(DAILY_CHECK_KEYS), help="打卡项")
    p_check.add_argument("--toggle", action="store_true", help="反转当前状态")
    p_check.add_argument("--push", action="store_true", help="打卡后自动推送")

    p_weight = sub.add_parser("weight", help="查看或记录个人体重健康数据")
    p_weight.add_argument("value", nargs="?", help="体重数值 (kg，留空查看历史)")
    p_weight.add_argument("--note", help="称重备注 (如 '晨起空腹')")

    sub.add_parser("memory", help="查看个人记忆与秩序原则")

    p_serve = sub.add_parser("serve", help="本地回环静态 Web 预览服务")
    p_serve.add_argument("--port", type=int, default=3000, help="预览端口 (默认 3000)")

    sub.add_parser("publish", help="发布公开产物到阿里云 ops-hub 站点")
    sub.add_parser("finance", help="同步日记个人消费至财务账本并发布")
    sub.add_parser("quota", help="查看 AI 额度快照并判定早停")

    p_vita = sub.add_parser("sync-service", help="核对/部署阿里云 VitaFlow 同步服务")
    p_vita.add_argument("sync_action", choices=["status", "deploy"], help="操作")

    p_sched = sub.add_parser("schedule", help="管理 macOS 原生 launchd 定时同步")
    p_sched.add_argument("sched_action", choices=["install", "status", "uninstall"], help="操作")

    return parser


COMMAND_HANDLERS = {
    None: cli_commands.cmd_status,
    "status": cli_commands.cmd_status,
    "dispatch": cli_commands.cmd_dispatch,
    "sync": cli_commands.cmd_sync,
    "career": cli_commands.cmd_career,
    "check": cli_commands.cmd_check,
    "weight": cli_commands.cmd_weight,
    "memory": cli_commands.cmd_memory,
    "serve": cli_commands.cmd_serve,
    "publish": cli_commands.cmd_publish,
    "finance": cli_commands.cmd_finance,
    "quota": cli_commands.cmd_quota,
    "sync-service": cli_commands.cmd_sync_service,
    "schedule": cli_commands.cmd_schedule,
}


def main(argv=None):
    args = build_parser().parse_args(argv)
    handler = COMMAND_HANDLERS.get(args.command, cli_commands.cmd_status)
    handler(args)


if __name__ == "__main__":
    main()
