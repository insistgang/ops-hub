        data = json.load(f)

    meta = data.get("meta", {})
    topo = data.get("topology", {})
    mac = topo.get("mac", {})
    win = topo.get("windows", {})
    jetson = topo.get("jetson", {})
    career = data.get("career_summary", {})
    c_stats = career.get("stats", {})
    c_records = career.get("records", [])
    projects = data.get("projects_and_exams", [])
    weight = data.get("weight_challenge", {})
